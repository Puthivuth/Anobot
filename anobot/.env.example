# PostgreSQL database password for the 'anobot' database user
POSTGRES_PASSWORD=

# Secret key used for signing session tokens and JWTs (keep this secret)
SECRET_KEY=

# Master encryption key (Fernet key) used to encrypt Gemini API keys in the database
# Must be a 32-byte url-safe base64-encoded string
MASTER_ENCRYPTION_KEY=

# S3 / MinIO object storage credentials for storing uploaded images and model weights
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Default Gemini model used for AI-assisted labeling and suggestions
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# Training device: 'cuda:0' if you have an NVIDIA GPU, or 'cpu' for standard processor
TRAINING_DEVICE=cuda:0
